--- a/src/xrt/ipc/shared/proto/50-compositor.json
+++ b/src/xrt/ipc/shared/proto/50-compositor.json
@@ -104,6 +104,19 @@
 
 	"compositor_destroy_passthrough": {},
 
+	"compositor_fence_import": {
+		"in_handles": {"type": "xrt_graphics_sync_handle_t"},
+		"out": [
