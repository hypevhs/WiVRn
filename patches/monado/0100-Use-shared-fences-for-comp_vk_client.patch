From 74ba1b76e12ad735be4e9db6e5eda27ef11dde17 Mon Sep 17 00:00:00 2001
From: Patrick Nicolas <patricknicolas@laposte.net>
Date: Sat, 30 May 2026 11:28:19 +0200
Subject: [PATCH 04/11] c/multi: Implement layer_commit_with_fence

Signed-off-by: Patrick Nicolas <patricknicolas@laposte.net>
---
 src/xrt/compositor/multi/comp_multi_compositor.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/src/xrt/compositor/multi/comp_multi_compositor.c b/src/xrt/compositor/multi/comp_multi_compositor.c
index 7deb507d2..153aba660 100644
--- a/src/xrt/compositor/multi/comp_multi_compositor.c
+++ b/src/xrt/compositor/multi/comp_multi_compositor.c
@@ -822,6 +822,19 @@ multi_compositor_layer_commit(struct xrt_compositor *xc, xrt_graphics_sync_handl
 	return XRT_SUCCESS;
 }
 
+static xrt_result_t
+multi_compositor_layer_commit_with_fence(struct xrt_compositor *xc, struct xrt_compositor_fence *xcf)
+{
+	COMP_TRACE_MARKER();
+
+	struct multi_compositor *mc = multi_compositor(xc);
+	int64_t frame_id = mc->progress.data.frame_id;
+
+	push_fence_to_wait_thread(mc, frame_id, xcf);
+
+	return XRT_SUCCESS;
+}
+
 static xrt_result_t
 multi_compositor_layer_commit_with_semaphore(struct xrt_compositor *xc,
                                              struct xrt_compositor_semaphore *xcsem,
@@ -1003,6 +1016,7 @@ multi_compositor_create(struct multi_system_compositor *msc,
 	mc->base.base.layer_equirect1 = multi_compositor_layer_equirect1;
 	mc->base.base.layer_equirect2 = multi_compositor_layer_equirect2;
