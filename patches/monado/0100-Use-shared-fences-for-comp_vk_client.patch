From 84bbaedd4e1a58ae1ca85ef0e155fa69c854c6af Mon Sep 17 00:00:00 2001
From: Patrick Nicolas <patricknicolas@laposte.net>
Date: Sat, 30 May 2026 23:26:36 +0200
Subject: [PATCH 05/11] ipc: Add fence import/destroy functions

Signed-off-by: Patrick Nicolas <patricknicolas@laposte.net>
---
 src/xrt/include/xrt/xrt_handles.h             |  2 +
 src/xrt/ipc/server/ipc_server.h               |  4 ++
 src/xrt/ipc/server/ipc_server_handler.c       | 69 +++++++++++++++++++
 .../ipc/server/ipc_server_per_client_thread.c |  6 ++
 src/xrt/ipc/shared/proto/50-compositor.json   | 13 ++++
 5 files changed, 94 insertions(+)

diff --git a/src/xrt/include/xrt/xrt_handles.h b/src/xrt/include/xrt/xrt_handles.h
index e6222abae..97f258742 100644
--- a/src/xrt/include/xrt/xrt_handles.h
+++ b/src/xrt/include/xrt/xrt_handles.h
@@ -366,6 +366,7 @@ typedef int xrt_graphics_sync_handle_t;
  */
 #define XRT_GRAPHICS_SYNC_HANDLE_IS_FD 1
 
+#define XRT_FENCE_HANDLE_TYPE XRT_SYNC_HANDLE_OPAQUE_FD
 #define XRT_TEMPORARY_FENCE_HANDLE_TYPE XRT_SYNC_HANDLE_SYNC_FD
 
 /*!
@@ -406,6 +407,7 @@ typedef HANDLE xrt_graphics_sync_handle_t;
  */
 #define XRT_GRAPHICS_SYNC_HANDLE_IS_WIN32_HANDLE 1
 
+#define XRT_FENCE_HANDLE_TYPE XRT_SYNC_HANDLE_OPAQUE_WIN32
 #define XRT_TEMPORARY_FENCE_HANDLE_TYPE XRT_SYNC_HANDLE_OPAQUE_WIN32
 
 /*!
diff --git a/src/xrt/ipc/server/ipc_server.h b/src/xrt/ipc/server/ipc_server.h
index 4e781ed6c..9f3731127 100644
--- a/src/xrt/ipc/server/ipc_server.h
+++ b/src/xrt/ipc/server/ipc_server.h
@@ -63,6 +63,7 @@ extern "C" {
 #define IPC_MAX_CLIENT_HAND_TRACKERS 16
 #define IPC_MAX_CLIENT_APP_INSTANCES 4
 #define IPC_MAX_CLIENT_APP_SYSTEMS (IPC_MAX_CLIENT_APP_INSTANCES * 4)
+#define IPC_MAX_CLIENT_FENCES 2
 #define IPC_MAX_CLIENT_SEMAPHORES 8
 #define IPC_MAX_CLIENT_SWAPCHAINS (XRT_MAX_LAYERS * 2)
 #define IPC_MAX_CLIENT_SPACES 128
@@ -160,6 +161,9 @@ struct ipc_client_state
 	//! Data for the swapchains.
 	struct ipc_swapchain_data swapchain_data[IPC_MAX_CLIENT_SWAPCHAINS];
 
+	//! Ptrs to the fences.
+	struct xrt_compositor_fence *xcfs[IPC_MAX_CLIENT_FENCES];
+
 	//! Number of compositor semaphores in use by client
 	uint32_t compositor_semaphore_count;
 
diff --git a/src/xrt/ipc/server/ipc_server_handler.c b/src/xrt/ipc/server/ipc_server_handler.c
index 5df3612b6..81f85f410 100644
--- a/src/xrt/ipc/server/ipc_server_handler.c
+++ b/src/xrt/ipc/server/ipc_server_handler.c
@@ -1606,6 +1606,75 @@ ipc_handle_system_set_client_io_blocks(volatile struct ipc_client_state *_ics,
 	return ipc_server_set_client_io_blocks(s, client_id, blocks);
 }
 
+/*
+ *
+ * Compositor fence functions.
+ *
+ */
+
+xrt_result_t
+ipc_handle_compositor_fence_import(volatile struct ipc_client_state *ics,
+                                   uint32_t *out_id,
+                                   const xrt_graphics_sync_handle_t *handles,
+                                   const uint32_t handle_count)
+{
+	xrt_result_t xret;
+
+	if (ics->xc == NULL) {
+		return XRT_ERROR_IPC_SESSION_NOT_CREATED;
+	}
+
+	if (handle_count != 1) {
+		return XRT_ERROR_INVALID_ARGUMENT;
+	}
+
+	int id = 0;
+	for (; id < IPC_MAX_CLIENT_FENCES; id++) {
+		if (ics->xcfs[id] == NULL) {
+			break;
+		}
+	}
+
+	if (id == IPC_MAX_CLIENT_FENCES) {
+		IPC_ERROR(ics->server, "Too many compositor fences alive!");
+		return XRT_ERROR_IPC_FAILURE;
+	}
+
+	struct xrt_compositor_fence *xcf = NULL;
+	xrt_graphics_sync_handle_t handle = handles[0];
+
+	xret = xrt_comp_import_fence(ics->xc, handle, XRT_FENCE_HANDLE_TYPE, &xcf);
+	if (xret != XRT_SUCCESS) {
+		IPC_ERROR(ics->server, "Failed to import compositor fence!");
+		return xret;
+	}
+
+	// Set it directly, no need to use reference here.
+	ics->xcfs[id] = xcf;
+
+	// Set out parameters.
+	*out_id = id;
+
+	return XRT_SUCCESS;
+}
+
+xrt_result_t
+ipc_handle_compositor_fence_destroy(volatile struct ipc_client_state *ics, uint32_t id)
+{
+	if (ics->xc == NULL) {
+		return XRT_ERROR_IPC_SESSION_NOT_CREATED;
+	}
+
+	if (ics->xcfs[id] == NULL) {
+		IPC_ERROR(ics->server, "Client tried to delete non-existent compositor fence!");
+		return XRT_ERROR_IPC_FAILURE;
+	}
+
+	// Drop our reference, does NULL checking. Cast away volatile.
+	xrt_compositor_fence_reference((struct xrt_compositor_fence **)&ics->xcfs[id], NULL);
+
+	return XRT_SUCCESS;
+}
 
 /*
  *
diff --git a/src/xrt/ipc/server/ipc_server_per_client_thread.c b/src/xrt/ipc/server/ipc_server_per_client_thread.c
index 1ba3256a3..566d065be 100644
--- a/src/xrt/ipc/server/ipc_server_per_client_thread.c
+++ b/src/xrt/ipc/server/ipc_server_per_client_thread.c
@@ -459,6 +459,12 @@ ipc_server_client_destroy_session_and_compositor(volatile struct ipc_client_stat
 		IPC_TRACE(ics->server, "Destroyed swapchain %d.", j);
 	}
 
+	for (uint32_t j = 0; j < IPC_MAX_CLIENT_FENCES; j++) {
+		// Drop our reference, does NULL checking. Cast away volatile.
+		xrt_compositor_fence_reference((struct xrt_compositor_fence **)&ics->xcfs[j], NULL);
+		IPC_TRACE(ics->server, "Destroyed compositor fence %d.", j);
+	}
+
 	for (uint32_t j = 0; j < IPC_MAX_CLIENT_SEMAPHORES; j++) {
 		// Drop our reference, does NULL checking. Cast away volatile.
 		xrt_compositor_semaphore_reference((struct xrt_compositor_semaphore **)&ics->xcsems[j], NULL);
diff --git a/src/xrt/ipc/shared/proto/50-compositor.json b/src/xrt/ipc/shared/proto/50-compositor.json
