From d6e7837590466f233d4a938833b19ba8925054fd Mon Sep 17 00:00:00 2001
From: Patrick Nicolas <patricknicolas@laposte.net>
Date: Sat, 30 May 2026 23:38:02 +0200
Subject: [PATCH 07/11] ipc/compositor: Add fence import function

Signed-off-by: Patrick Nicolas <patricknicolas@laposte.net>
---
 src/xrt/ipc/client/ipc_client_compositor.c | 82 ++++++++++++++++++++++
 1 file changed, 82 insertions(+)

diff --git a/src/xrt/ipc/client/ipc_client_compositor.c b/src/xrt/ipc/client/ipc_client_compositor.c
index 4fc89d529..6b0fa5407 100644
--- a/src/xrt/ipc/client/ipc_client_compositor.c
+++ b/src/xrt/ipc/client/ipc_client_compositor.c
@@ -92,6 +92,19 @@ struct ipc_client_swapchain
 	uint32_t id;
 };
 
+/*!
+ * Client proxy for an xrt_compositor_fence implementation over IPC.
+ * @implements xrt_compositor_semaphore
+ */
+struct ipc_client_compositor_fence
+{
+	struct xrt_compositor_fence base;
+
+	struct ipc_client_compositor *icc;
+
+	uint32_t id;
+};
+
 /*!
  * Client proxy for an xrt_compositor_semaphore implementation over IPC.
  * @implements xrt_compositor_semaphore
@@ -124,6 +137,12 @@ ipc_client_swapchain(struct xrt_swapchain *xs)
 	return (struct ipc_client_swapchain *)xs;
 }
 
+static inline struct ipc_client_compositor_fence *
+ipc_client_compositor_fence(struct xrt_compositor_fence *xcf)
+{
+	return (struct ipc_client_compositor_fence *)xcf;
+}
+
 static inline struct ipc_client_compositor_semaphore *
 ipc_client_compositor_semaphore(struct xrt_compositor_semaphore *xcsem)
 {
@@ -208,6 +227,38 @@ ipc_compositor_swapchain_release_image(struct xrt_swapchain *xsc, uint32_t index
 	IPC_CHK_ALWAYS_RET(icc->ipc_c, xret, "ipc_call_swapchain_release_image");
 }
 
+/*
+ *
+ * Compositor fence functions.
+ *
+ */
+
+static xrt_result_t
+ipc_client_compositor_fence_wait(struct xrt_compositor_fence *xcf, uint64_t timeout_ns)
+{
+	struct ipc_client_compositor_fence *iccf = ipc_client_compositor_fence(xcf);
+	struct ipc_client_compositor *icc = iccf->icc;
+
+	IPC_ERROR(icc->ipc_c, "Cannot call wait on client side!");
+
+	return XRT_ERROR_IPC_FAILURE;
+}
+
+static void
+ipc_client_compositor_fence_destroy(struct xrt_compositor_fence *xcf)
+{
+	struct ipc_client_compositor_fence *iccs = ipc_client_compositor_fence(xcf);
+	struct ipc_client_compositor *icc = iccs->icc;
+	xrt_result_t xret;
+
+	xret = ipc_call_compositor_fence_destroy(icc->ipc_c, iccs->id);
+
+	// Can't return anything here, just continue.
+	IPC_CHK_ONLY_PRINT(icc->ipc_c, xret, "ipc_call_compositor_fence_destroy");
+
+	free(iccs);
+}
+
 
 /*
  *
@@ -470,6 +521,36 @@ ipc_compositor_swapchain_import(struct xrt_compositor *xc,
 	return swapchain_server_import(icc, info, native_images, image_count, out_xsc);
 }
 
+static xrt_result_t
+ipc_compositor_fence_import(struct xrt_compositor *xc,
+                            xrt_graphics_sync_handle_t handle,
+                            enum xrt_graphics_sync_handle_type handle_type,
+                            struct xrt_compositor_fence **out_xcf)
+{
+	struct ipc_client_compositor *icc = ipc_client_compositor(xc);
+	xrt_result_t xret;
+	uint32_t id = 0;
+
+	if (handle_type != XRT_FENCE_HANDLE_TYPE) {
+		IPC_ERROR(icc->ipc_c, "invalid fence type to import");
+		return XRT_ERROR_INVALID_ARGUMENT;
+	}
+
+	xret = ipc_call_compositor_fence_import(icc->ipc_c, &handle, 1, &id);
+	IPC_CHK_AND_RET(icc->ipc_c, xret, "ipc_call_compositor_fence_import");
+
+	struct ipc_client_compositor_fence *iccf = U_TYPED_CALLOC(struct ipc_client_compositor_fence);
+	iccf->base.reference.count = 1;
+	iccf->base.wait = ipc_client_compositor_fence_wait;
+	iccf->base.destroy = ipc_client_compositor_fence_destroy;
+	iccf->id = id;
+	iccf->icc = icc;
+
+	*out_xcf = &iccf->base;
+
+	return XRT_SUCCESS;
+}
+
 static xrt_result_t
 ipc_compositor_semaphore_create(struct xrt_compositor *xc,
                                 xrt_graphics_sync_handle_t *out_handle,
@@ -889,6 +970,7 @@ ipc_compositor_init(struct ipc_client_compositor *icc, struct xrt_compositor_nat
 	icc->base.base.get_swapchain_create_properties = ipc_compositor_get_swapchain_create_properties;
 	icc->base.base.create_swapchain = ipc_compositor_swapchain_create;
 	icc->base.base.import_swapchain = ipc_compositor_swapchain_import;
+	icc->base.base.import_fence = ipc_compositor_fence_import;
 	icc->base.base.create_semaphore = ipc_compositor_semaphore_create;
 	icc->base.base.create_passthrough = ipc_compositor_create_passthrough;
 	icc->base.base.create_passthrough_layer = ipc_compositor_create_passthrough_layer;
