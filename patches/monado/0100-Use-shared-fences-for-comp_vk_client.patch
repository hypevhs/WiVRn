From 5d064b8d03ecbc8b61959e248ac899fce587dfcb Mon Sep 17 00:00:00 2001
From: Patrick Nicolas <patricknicolas@laposte.net>
Date: Sat, 30 May 2026 23:29:50 +0200
Subject: [PATCH 06/11] ipc: add layer_sync_with_fence

Signed-off-by: Patrick Nicolas <patricknicolas@laposte.net>
---
 src/xrt/ipc/server/ipc_server_handler.c     | 56 +++++++++++++++++++++
 src/xrt/ipc/shared/proto/50-compositor.json | 10 ++++
 2 files changed, 66 insertions(+)

diff --git a/src/xrt/ipc/server/ipc_server_handler.c b/src/xrt/ipc/server/ipc_server_handler.c
index 81f85f410..f69642273 100644
--- a/src/xrt/ipc/server/ipc_server_handler.c
+++ b/src/xrt/ipc/server/ipc_server_handler.c
@@ -1389,6 +1389,62 @@ ipc_handle_compositor_layer_sync(volatile struct ipc_client_state *ics,
 	return xret;
 }
 
+xrt_result_t
+ipc_handle_compositor_layer_sync_with_fence(volatile struct ipc_client_state *ics,
+                                            uint32_t slot_id,
+                                            uint32_t fence_id,
+                                            uint32_t *out_free_slot_id)
+{
+	IPC_TRACE_MARKER();
+
+	if (ics->xc == NULL) {
+		return XRT_ERROR_IPC_SESSION_NOT_CREATED;
+	}
+	if (fence_id >= IPC_MAX_CLIENT_FENCES) {
+		IPC_ERROR(ics->server, "Invalid fence_id");
+		return XRT_ERROR_IPC_FAILURE;
+	}
+	if (ics->xcfs[fence_id] == NULL) {
+		IPC_ERROR(ics->server, "Fence of id %u not created!", fence_id);
+		return XRT_ERROR_IPC_FAILURE;
+	}
+
+	struct xrt_compositor_fence *xcf = NULL;
+	xrt_compositor_fence_reference(&xcf, ics->xcfs[fence_id]);
+
+	struct ipc_shared_memory *ism = get_ism(ics);
+	struct ipc_layer_slot *slot = &ism->slots[slot_id];
+
+	// Copy current slot data.
+	struct ipc_layer_slot copy = *slot;
+
+
+
+	/*
+	 * Transfer data to underlying compositor.
+	 */
+
+	xrt_comp_layer_begin(ics->xc, &copy.data);
+
+	_update_layers(ics, ics->xc, &copy);
+
+	xrt_comp_layer_commit_with_fence(ics->xc, xcf);
+
+
+	/*
+	 * Manage shared state.
+	 */
+
+	os_mutex_lock(&ics->server->global_state.lock);
+
+	*out_free_slot_id = (ics->server->current_slot_index + 1) % IPC_MAX_SLOTS;
+	ics->server->current_slot_index = *out_free_slot_id;
+
+	os_mutex_unlock(&ics->server->global_state.lock);
+
+	return XRT_SUCCESS;
+}
+
 xrt_result_t
 ipc_handle_compositor_layer_sync_with_semaphore(volatile struct ipc_client_state *ics,
                                                 uint32_t slot_id,
diff --git a/src/xrt/ipc/shared/proto/50-compositor.json b/src/xrt/ipc/shared/proto/50-compositor.json
index 304d1ced5..f4c31e7cb 100644
--- a/src/xrt/ipc/shared/proto/50-compositor.json
+++ b/src/xrt/ipc/shared/proto/50-compositor.json
@@ -44,6 +44,16 @@
 		]
 	},
 
+	"compositor_layer_sync_with_fence": {
+		"in": [
+			{"name": "slot_id", "type": "uint32_t"},
+			{"name": "fence_id", "type": "uint32_t"}
+		],
+		"out": [
+			{"name": "free_slot_id", "type": "uint32_t"}
+		]
+	},
+
 	"compositor_layer_sync_with_semaphore": {
 		"in": [
 			{"name": "slot_id", "type": "uint32_t"},
