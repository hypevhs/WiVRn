From 87f143ceb77f2f3c342638bf8347cfc4f740fb32 Mon Sep 17 00:00:00 2001
From: Patrick Nicolas <patricknicolas@laposte.net>
Date: Sat, 30 May 2026 10:39:30 +0200
Subject: [PATCH 01/11] c/util: Use reference counting for fences

Signed-off-by: Patrick Nicolas <patricknicolas@laposte.net>
---
 .../compositor/multi/comp_multi_compositor.c  |  2 +-
 src/xrt/compositor/util/comp_sync.c           |  1 +
 src/xrt/include/xrt/xrt_compositor.h          | 40 ++++++++++++++-----
 3 files changed, 31 insertions(+), 12 deletions(-)

diff --git a/src/xrt/compositor/multi/comp_multi_compositor.c b/src/xrt/compositor/multi/comp_multi_compositor.c
index 33675d43f..65b6d4e23 100644
--- a/src/xrt/compositor/multi/comp_multi_compositor.c
+++ b/src/xrt/compositor/multi/comp_multi_compositor.c
@@ -145,7 +145,7 @@ wait_fence(struct multi_compositor *mc, struct xrt_compositor_fence **xcf_ptr)
 		U_LOG_W("Waiting on client fence timed out > 100ms!");
 	} while (os_thread_helper_is_running(&mc->wait_thread.oth));
 
-	xrt_compositor_fence_destroy(xcf_ptr);
+	xrt_compositor_fence_reference(xcf_ptr, NULL);
 
 	if (ret != XRT_SUCCESS) {
 		U_LOG_E("Fence waiting failed!");
diff --git a/src/xrt/compositor/util/comp_sync.c b/src/xrt/compositor/util/comp_sync.c
index 6a4ffb833..b2ca933af 100644
--- a/src/xrt/compositor/util/comp_sync.c
+++ b/src/xrt/compositor/util/comp_sync.c
@@ -112,6 +112,7 @@ comp_fence_import(struct vk_bundle *vk, xrt_graphics_sync_handle_t handle, struc
 	VK_NAME_FENCE(vk, fence, "Comp Sync");
 
 	struct fence *f = U_TYPED_CALLOC(struct fence);
+	f->base.reference.count = 1;
 	f->base.wait = fence_wait;
 	f->base.destroy = fence_destroy;
 	f->fence = fence;
diff --git a/src/xrt/include/xrt/xrt_compositor.h b/src/xrt/include/xrt/xrt_compositor.h
index 76c1f7e9b..3d2556f8e 100644
--- a/src/xrt/include/xrt/xrt_compositor.h
+++ b/src/xrt/include/xrt/xrt_compositor.h
@@ -786,6 +786,11 @@ xrt_swapchain_release_image(struct xrt_swapchain *xsc, uint32_t index)
  */
 struct xrt_compositor_fence
 {
+	/*!
+	 * Reference helper.
+	 */
+	struct xrt_reference reference;
+
 	/*!
 	 * Waits on the fence with the given timeout.
 	 */
@@ -811,23 +816,36 @@ xrt_compositor_fence_wait(struct xrt_compositor_fence *xcf, uint64_t timeout)
 }
 
 /*!
- * @copydoc xrt_compositor_fence::destroy
- *
- * Helper for calling through the function pointer: does a null check and sets
- * xcf_ptr to null if freed.
+ * Update the reference counts on compositor fence(s).
  *
- * @public @memberof xrt_compositor_fence
+ * @param[in,out] dst Pointer to a object reference: if the object reference is
+ *                non-null will decrement its counter. The reference that
+ *                @p dst points to will be set to @p src.
+ * @param[in] src New object for @p dst to refer to (may be null).
+ *                If non-null, will have its refcount increased.
+ * @ingroup xrt_iface
+ * @relates xrt_compositor_fence
  */
-static inline void
-xrt_compositor_fence_destroy(struct xrt_compositor_fence **xcf_ptr)
+XRT_NONNULL_FIRST static inline void
+xrt_compositor_fence_reference(struct xrt_compositor_fence **dst, struct xrt_compositor_fence *src)
 {
-	struct xrt_compositor_fence *xcf = *xcf_ptr;
-	if (xcf == NULL) {
+	struct xrt_compositor_fence *old_dst = *dst;
+
+	if (old_dst == src) {
 		return;
 	}
 
-	xcf->destroy(xcf);
-	*xcf_ptr = NULL;
+	if (src) {
+		xrt_reference_inc(&src->reference);
+	}
+
+	*dst = src;
+
+	if (old_dst) {
+		if (xrt_reference_dec_and_is_zero(&old_dst->reference)) {
+			old_dst->destroy(old_dst);
+		}
+	}
 }
 
 
-- 
2.55.0


