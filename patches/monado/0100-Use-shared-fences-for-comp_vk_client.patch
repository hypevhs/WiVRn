Subject: [PATCH 03/11] xrt/compositor: Add commit_with_fence

Signed-off-by: Patrick Nicolas <patricknicolas@laposte.net>
---
 src/xrt/include/xrt/xrt_compositor.h | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/src/xrt/include/xrt/xrt_compositor.h b/src/xrt/include/xrt/xrt_compositor.h
index 09467bceb..72236009d 100644
--- a/src/xrt/include/xrt/xrt_compositor.h
+++ b/src/xrt/include/xrt/xrt_compositor.h
@@ -1421,6 +1421,16 @@ struct xrt_compositor
 	 */
 	xrt_result_t (*layer_commit)(struct xrt_compositor *xc, xrt_graphics_sync_handle_t sync_handle);
 
+	/*!
+	 * @brief Commits all of the submitted layers, with a fence.
+	 *
+	 * Only after this call will the compositor actually use the layers.
+	 * @param xc          Self pointer
+	 * @param xcf         Fence that will be signalled when the app GPU
+	 *                    work has completed.
+	 */
+	xrt_result_t (*layer_commit_with_fence)(struct xrt_compositor *xc, struct xrt_compositor_fence *xcf);
+
 	/*!
 	 * @brief Commits all of the submitted layers, with a semaphore.
 	 *
@@ -1905,6 +1915,19 @@ xrt_comp_layer_commit(struct xrt_compositor *xc, xrt_graphics_sync_handle_t sync
 	return xc->layer_commit(xc, sync_handle);
 }
 
+/*!
+ * @copydoc xrt_compositor::layer_commit_with_fence
+ *
+ * Helper for calling through the function pointer.
+ *
+ * @public @memberof xrt_compositor
+ */
+XRT_NONNULL_ALL static inline xrt_result_t
+xrt_comp_layer_commit_with_fence(struct xrt_compositor *xc, struct xrt_compositor_fence *xcf)
+{
+	return xc->layer_commit_with_fence(xc, xcf);
+}
+
